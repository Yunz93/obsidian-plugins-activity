{
  "name": "plugins-activity",
  "version": "0.1.5",
  "description": "Obsidian 插件：本地统计第三方插件使用情况。",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "vitest run",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "sync": "npm run build && node scripts/sync-plugin.mjs"
  },
  "keywords": [
    "obsidian",
    "plugins",
    "usage",
    "statistics"
  ],
  "author": "Yunz",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.30",
    "esbuild": "^0.25.0",
    "obsidian": "^1.5.12",
    "typescript": "^5.4.5",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "monkey-around": "^3.0.0"
  }
}
